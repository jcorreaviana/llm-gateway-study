# Copie para .env (que NUNCA é versionado) e preencha localmente.

# Chamadas reais à API só acontecem com ENABLE_REAL_API=1. Padrão: 0.
ENABLE_REAL_API=0
ANTHROPIC_API_KEY=coloque_sua_chave_aqui

# Modelo e limites das chamadas reais
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_MAX_TOKENS=50
REAL_API_CALL_LIMIT=30

# Ollama local
OLLAMA_BASE_URL=http://localhost:11434
